# Copy this file to .env and fill in your values.
# LLM Inspector never ships with a key baked in — you always bring your own.

# ─── LLM Provider ──────────────────────────────────────────────────────
# Which LLM to use as the reasoning brain. Supported: anthropic, openai,
# groq, gemini, ollama. If not set, auto-detected from whichever API key is present.
# LLM_INSPECTOR_PROVIDER=anthropic

# ─── API Keys (set the one matching your provider) ─────────────────────
# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o, o3, etc.)
# OPENAI_API_KEY=sk-...

# Google Gemini
# GEMINI_API_KEY=AI...

# Groq (fast inference, OpenAI-compatible)
# GROQ_API_KEY=gsk_...

# Ollama needs no API key — just a running Ollama instance.
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Model ─────────────────────────────────────────────────────────────
# Override the default model for your provider. If not set, uses a
# sensible default per provider:
#   anthropic -> claude-sonnet-4-20250514
#   openai    -> gpt-4o
#   groq      -> openai/gpt-oss-20b
#   gemini    -> gemini-2.5-flash
#   ollama    -> qwen2.5:14b
# LLM_INSPECTOR_MODEL=claude-sonnet-4-20250514

# ─── Base URL (optional) ──────────────────────────────────────────────
# For Ollama or OpenAI-compatible endpoints (e.g. Azure OpenAI, LM Studio).
# LLM_INSPECTOR_BASE_URL=http://localhost:11434

# ─── Storage ───────────────────────────────────────────────────────────
# Where scan data (SQLite DB, reports, memory) is stored.
LLM_INSPECTOR_DATA_DIR=.llm_inspector_data

# ─── Budget ────────────────────────────────────────────────────────────
# Default per-scan budget caps (can be overridden per-scan via CLI flags).
LLM_INSPECTOR_MAX_SCAN_SECONDS=1200
LLM_INSPECTOR_MAX_TOOL_CALLS=150
LLM_INSPECTOR_MAX_USD=5.00
